---
interface Props {
  title: string;
  prompt?: string;
}

const { title, prompt } = Astro.props;

import "katex/dist/katex.min.css";
import IslandPageIcon from "./island/IslandPageIcon";
import IslandPromptNotice from "./island/IslandPromptNotice";
import { t } from "../lib/ui";
---

<div class="island-prompt-card island-prompt-locked hidden" data-prompt-locked>
  <div class="island-prompt-row">
    <IslandPageIcon client:load size={28} />
    <div class="island-prompt-meta">
      <p class="island-prompt-title">{t("promptLockedTitle")}</p>
      <p class="island-prompt-lead">{t("promptLockedLead")}</p>
    </div>
    <div class="island-prompt-actions">
      <a class="theme-button" href="/">{t("chooseIdentity")}</a>
    </div>
  </div>
</div>

<div class="agent-prompt-card island-prompt-card hidden" data-lesson-title={title} data-prompt={prompt}>
  <div class="island-prompt-row">
    <IslandPageIcon client:load size={28} />
    <div class="island-prompt-meta">
      <p class="island-prompt-title">教师同行</p>
      <p class="island-prompt-lead">{t("promptStepsLead")}</p>
    </div>
    <div class="island-prompt-actions">
      <button type="button" class="island-prompt-expand" aria-expanded="false">
        <span class="island-prompt-expand-text">{t("promptExpand")}</span>
        <svg class="island-prompt-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" class="theme-button agent-prompt-copy">{t("copyPrompt")}</button>
    </div>
  </div>
  <div class="island-prompt-unfold" aria-hidden="true">
    <div class="island-prompt-sheet">
      <div class="island-prompt-sheet-inner">
        <pre class="agent-prompt-text island-prompt-body"></pre>
      </div>
    </div>
  </div>
  <p role="status" aria-live="polite" class="agent-prompt-confirm sr-only"></p>
  <IslandPromptNotice client:load />
</div>

<script is:inline>
  (function() {
    function setPromptOpen(card, open) {
      var unfold = card.querySelector(".island-prompt-unfold");
      var toggle = card.querySelector(".island-prompt-expand");
      var textSpan = toggle ? toggle.querySelector(".island-prompt-expand-text") : null;
      if (!unfold || !toggle) return;
      card.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      unfold.setAttribute("aria-hidden", open ? "false" : "true");
      var label = open ? window.schoolUI.t("promptCollapse") : window.schoolUI.t("promptExpand");
      if (textSpan) {
        textSpan.textContent = label;
      } else {
        toggle.textContent = label;
      }
    }

    document.querySelectorAll(".island-prompt-expand").forEach(function(toggle) {
      toggle.addEventListener("click", function() {
        var card = toggle.closest(".agent-prompt-card");
        if (!card) return;
        setPromptOpen(card, toggle.getAttribute("aria-expanded") !== "true");
      });
    });

    window.addEventListener("school:island-lesson-tab", function(event) {
      if (!event.detail || event.detail.panel !== "teach") return;
      document.querySelectorAll(".agent-prompt-card").forEach(function(card) {
        setPromptOpen(card, true);
      });
    });

    if (!window.school) return;
    var studentId = window.school.getStudentId();
    if (!studentId) {
      document.querySelectorAll("[data-prompt-locked]").forEach(function(el) {
        el.classList.remove("hidden");
      });
      return;
    }

    document.querySelectorAll(".agent-prompt-card").forEach(function(card) {
      var lessonTitle = card.getAttribute("data-lesson-title");
      var promptText = card.querySelector(".agent-prompt-text");
      var copyBtn = card.querySelector(".agent-prompt-copy");
      var confirm = card.querySelector(".agent-prompt-confirm");
      if (!promptText) return;

      var customPrompt = card.getAttribute("data-prompt");
      var schoolName = document.querySelector("[data-school-name]");
      var name = schoolName ? schoolName.getAttribute("data-school-name") : window.schoolUI.t("thisSchool");
      var origin = window.location.origin;
      var pathParts = window.location.pathname.split("/").filter(Boolean);
      var lessonSlug = pathParts[pathParts.length - 1] || lessonTitle || "";
      var kind = pathParts[0] === "exercises" ? "exercises" : "lessons";
      var prompt = window.schoolUI.t("promptIdentity", { school: name, student: studentId }) + "\n\n" +
        (customPrompt || window.schoolUI.t("promptLesson", { title: lessonTitle })) + "\n\n" +
        window.schoolUI.t("promptContract", { origin: origin, kind: kind, slug: encodeURIComponent(lessonSlug), student: encodeURIComponent(studentId) });
      promptText.textContent = prompt;
      card.classList.remove("hidden");

      var copyTimeout;
      if (copyBtn) copyBtn.addEventListener("click", function() {
        Promise.resolve().then(function() {
          return navigator.clipboard.writeText(prompt);
        }).then(function() {
          if (confirm) {
            confirm.textContent = window.schoolUI.t("promptCopiedNotice");
          }
          var originalText = copyBtn.getAttribute("data-original-text") || copyBtn.textContent;
          copyBtn.setAttribute("data-original-text", originalText);
          copyBtn.textContent = window.schoolUI.t("promptCopiedButton");
          clearTimeout(copyTimeout);
          copyTimeout = setTimeout(function() {
            copyBtn.textContent = originalText;
          }, 2000);

          window.dispatchEvent(new CustomEvent("school:island-prompt-copied", {
            detail: { trigger: copyBtn }
          }));
        }).catch(function() {
          if (confirm) {
            confirm.textContent = window.schoolUI.t("copyError");
            confirm.classList.remove("sr-only");
          }
        });
      });
    });
  })();
</script>

<style is:global>
.katex .mord.text,
.katex .cjk_fallback {
  font-family: "PingFang SC", "Noto Sans SC", "Microsoft YaHei", ui-sans-serif, system-ui, sans-serif;
}
</style>
