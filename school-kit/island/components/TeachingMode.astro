---
import settings from "../../school.settings.json";
import { normalizeTeachingMode } from "../lib/teaching";

const defaultMode = normalizeTeachingMode(settings.teachingMode);

import { t } from "../lib/ui";
import IslandModeTip from "./island/IslandModeTip";
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section
  id="teaching-mode-control"
  class={compact ? "island-mode-panel island-mode-compact mb-4 p-3.5 rounded-xl" : "mb-6 rounded-xl island-mode-panel p-5"}
  data-default-mode={defaultMode}
>
  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
    <h2 class={`font-mono font-semibold uppercase tracking-wider text-gray-700 dark:text-stone-300 ${compact ? "text-xs" : "text-sm"}`}>{t("teachingMode")}</h2>
    {compact && <p class="text-xs text-gray-500 dark:text-stone-500">{t("modeScope")}</p>}
  </div>
  {!compact && <p class="mt-1.5 text-sm text-gray-600 dark:text-stone-400">{t("modeScope")}</p>}
  <div class={`grid grid-cols-2 gap-2 ${compact ? "mt-2" : "mt-3.5"}`} role="group" aria-label={t("teachingMode")}>
    <IslandModeTip client:load mode="simple" label={t("simple")} title={t("simpleDescription")} compact={compact} />
    <IslandModeTip client:load mode="immersive" label={t("immersive")} title={t("immersiveDescription")} compact={compact} />
  </div>
  <p id="teaching-mode-status" class="mt-2 text-xs text-gray-500 dark:text-stone-500" role="status" aria-live="polite"></p>
  <p id="teaching-mode-error" class="mt-2 hidden text-xs text-red-600 dark:text-red-400" role="alert"></p>
</section>

<script is:inline>
  (function() {
    var root = document.getElementById("teaching-mode-control");
    if (!root) return;
    var status = document.getElementById("teaching-mode-status");
    var error = document.getElementById("teaching-mode-error");
    var defaultMode = root.getAttribute("data-default-mode") === "immersive" ? "immersive" : "simple";
    var pending = false;
    var selectionRevision = 0;

    function getActiveStudentId() {
      if (window.school && typeof window.school.getStudentId === "function") {
        var sid = window.school.getStudentId();
        if (sid) return sid;
      }
      try {
        var fromStorage = localStorage.getItem("studentId");
        if (fromStorage) return fromStorage;
      } catch (_) {}
      try {
        var params = new URLSearchParams(window.location.search);
        var fromUrl = params.get("sid");
        if (fromUrl) {
          if (window.school && typeof window.school.setStudentId === "function") {
            window.school.setStudentId(fromUrl);
          } else {
            localStorage.setItem("studentId", fromUrl);
          }
          return fromUrl;
        }
      } catch (_) {}
      return null;
    }

    function localMode() {
      try {
        var value = localStorage.getItem("teachingMode");
        return value === "immersive" || value === "simple" ? value : defaultMode;
      } catch (_) {
        return defaultMode;
      }
    }

    function setLocalMode(mode) {
      try { localStorage.setItem("teachingMode", mode); } catch (_) {}
    }

    function modeButtons() {
      return Array.prototype.slice.call(root.querySelectorAll("[data-teaching-mode]"));
    }

    function setVisualMode(mode) {
      modeButtons().forEach(function(button) {
        var selected = button.getAttribute("data-teaching-mode") === mode;
        button.setAttribute("aria-pressed", selected ? "true" : "false");
        button.classList.toggle("theme-active-nav", selected);
        button.classList.toggle("border-gray-300", !selected);
        button.classList.toggle("dark:border-stone-700", !selected);
        button.classList.toggle("border-transparent", selected);
      });
      root.dispatchEvent(new CustomEvent("teaching-mode-visual", { detail: mode }));
    }

    function setButtonsDisabled(disabled) {
      modeButtons().forEach(function(button) {
        button.disabled = disabled;
        button.classList.toggle("cursor-wait", disabled);
        button.classList.toggle("opacity-60", disabled);
      });
    }

    function setStatus(message) {
      if (status) status.textContent = message || "";
      if (error) error.classList.add("hidden");
    }

    function setError(message) {
      if (!error) return;
      if (status) status.textContent = "";
      error.textContent = message;
      error.classList.remove("hidden");
    }

    async function fetchProfileWithRetry(studentId) {
      var url = "/api/profile/" + encodeURIComponent(studentId);
      try {
        var res = await fetch(url);
        if (res.status === 404) return { status: 404 };
        if (!res.ok && res.status >= 500) {
          await new Promise(function(resolve) { setTimeout(resolve, 300); });
          res = await fetch(url);
          if (res.status === 404) return { status: 404 };
          if (!res.ok) throw new Error("status " + res.status);
        } else if (!res.ok) {
          throw new Error("status " + res.status);
        }
        return { ok: true, data: await res.json() };
      } catch (err) {
        if (err && err.name === "AbortError") return { aborted: true };
        try {
          await new Promise(function(resolve) { setTimeout(resolve, 300); });
          var retryRes = await fetch(url);
          if (retryRes.status === 404) return { status: 404 };
          if (!retryRes.ok) throw new Error("status " + retryRes.status);
          return { ok: true, data: await retryRes.json() };
        } catch (retryErr) {
          if (retryErr && retryErr.name === "AbortError") return { aborted: true };
          return { ok: false, error: retryErr };
        }
      }
    }

    async function saveForStudent(mode, studentId) {
      if (!studentId) {
        setStatus(window.schoolUI.t("modeBrowserSaved"));
        return true;
      }
      var url = "/api/profile/" + encodeURIComponent(studentId);
      var payload = JSON.stringify({ teachingMode: mode });
      var response;
      try {
        response = await fetch(url, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: payload,
        });
        if (!response.ok && response.status >= 500) {
          await new Promise(function(resolve) { setTimeout(resolve, 300); });
          response = await fetch(url, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: payload,
          });
        }
      } catch (netErr) {
        if (netErr && netErr.name === "AbortError") return true;
        await new Promise(function(resolve) { setTimeout(resolve, 300); });
        response = await fetch(url, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: payload,
        });
      }
      if (response.status === 404) {
        try {
          localStorage.removeItem("studentId");
          localStorage.removeItem("progress");
        } catch (_) {}
        if (window.school && typeof window.school.updateEnrolledIndicator === "function") {
          window.school.updateEnrolledIndicator();
        }
        if (window.school && typeof window.school.updateAllCheckmarks === "function") {
          window.school.updateAllCheckmarks();
        }
        setStatus(window.schoolUI.t("modeChoose"));
        return true;
      }
      if (!response.ok) throw new Error(window.schoolUI.t("modeSaveError"));
      var data = await response.json();
      if (window.school && typeof window.school.getCachedProgress === "function") {
        var progress = window.school.getCachedProgress() || {};
        progress.profile = data.profile;
        if (typeof window.school.setCachedProgress === "function") window.school.setCachedProgress(progress);
        window.dispatchEvent(new CustomEvent("school:progress", { detail: progress }));
      }
      setStatus(window.schoolUI.t("modeProfileSaved"));
      return true;
    }

    async function choose(mode) {
      if (mode !== "simple" && mode !== "immersive") return;
      if (pending) return;
      var previousMode = localMode();
      selectionRevision += 1;
      pending = true;
      setLocalMode(mode);
      setVisualMode(mode);
      setButtonsDisabled(true);
      var studentId = getActiveStudentId();
      setStatus(studentId ? window.schoolUI.t("saving") : window.schoolUI.t("modeBrowserSaved"));
      if (error) error.classList.add("hidden");
      try {
        await saveForStudent(mode, studentId);
      } catch (err) {
        if (studentId) {
          setLocalMode(previousMode);
          setVisualMode(previousMode);
        }
        setError(window.schoolUI.t("modeSaveRetry"));
      } finally {
        pending = false;
        setButtonsDisabled(false);
      }
    }

    root.addEventListener("click", function(event) {
      var target = event.target;
      if (!target || !target.closest) return;
      var button = target.closest("[data-teaching-mode]");
      if (!button || !root.contains(button)) return;
      choose(button.getAttribute("data-teaching-mode"));
    });

    var current = localMode();
    setVisualMode(current);
    var studentId = getActiveStudentId();
    if (studentId) {
      var profileLoadRevision = selectionRevision;
      var cached = window.school && typeof window.school.getCachedProgress === "function" ? window.school.getCachedProgress() : null;
      if (!cached) {
        try { cached = JSON.parse(localStorage.getItem("progress") || "null"); } catch (_) {}
      }
      var cachedProfile = cached && cached.profile;
      if (cachedProfile && (cachedProfile.teachingMode === "immersive" || cachedProfile.teachingMode === "simple")) {
        var cachedMode = cachedProfile.teachingMode;
        setLocalMode(cachedMode);
        setVisualMode(cachedMode);
        setStatus(window.schoolUI.t("modeLoaded"));
      }

      fetchProfileWithRetry(studentId).then(function(result) {
        if (result.aborted) return;
        if (result.status === 404) {
          try {
            localStorage.removeItem("studentId");
            localStorage.removeItem("progress");
          } catch (_) {}
          if (window.school && typeof window.school.updateEnrolledIndicator === "function") {
            window.school.updateEnrolledIndicator();
          }
          if (window.school && typeof window.school.updateAllCheckmarks === "function") {
            window.school.updateAllCheckmarks();
          }
          setStatus(window.schoolUI.t("modeChoose"));
          return;
        }
        if (!result.ok) {
          if (!cachedProfile || (cachedProfile.teachingMode !== "immersive" && cachedProfile.teachingMode !== "simple")) {
            setStatus(window.schoolUI.t("modeBrowserFallback"));
          }
          return;
        }
        if (selectionRevision !== profileLoadRevision) {
          setStatus(window.schoolUI.t("modeSelected"));
          return;
        }
        var data = result.data;
        var profileMode = data && data.profile && data.profile.teachingMode;
        var finalMode = profileMode === "immersive" || profileMode === "simple" ? profileMode : current;
        setLocalMode(finalMode);
        setVisualMode(finalMode);
        setStatus(window.schoolUI.t("modeLoaded"));
      });
    } else {
      setStatus(window.schoolUI.t("modeChoose"));
    }

    window.addEventListener("school:progress", function(event) {
      if (pending) return;
      var progress = event && event.detail;
      var profile = progress && progress.profile;
      var profileMode = profile && profile.teachingMode;
      if (profileMode !== "simple" && profileMode !== "immersive") return;
      setLocalMode(profileMode);
      setVisualMode(profileMode);
      setStatus(window.schoolUI.t("modeUpdated"));
    });

    window.addEventListener("school:enrolled", function() {
      var id = getActiveStudentId();
      saveForStudent(localMode(), id).catch(function(err) {
        setError(window.schoolUI.t("modeEnrollError"));
      });
    });
  })();
</script>
