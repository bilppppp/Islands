export const prerender = true;

import Base from "../../layouts/Base.astro";
import TeachingMode from "../../components/TeachingMode.astro";
import AgentPrompt from "../../components/AgentPrompt.astro";
import SourceCite from "../../components/SourceCite.astro";
import IslandMark from "../../components/island/IslandMark";
import LessonTabs from "../../components/island/LessonTabs";
import IslandTypewriter from "../../components/island/IslandTypewriter";
import IslandLessonChrome from "../../components/island/IslandLessonChrome";
import { Tag } from "animal-island-ui";
import { getCollection, render } from "astro:content";
import { scanCodeFences } from "../../lib/predict-block.mjs";
import { collectRunBlocks } from "../../lib/run-block.mjs";

export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  return lessons.map((lesson) => ({
    params: { slug: lesson.data.slug },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const lessonBody = lesson.body ?? "";
const fences = scanCodeFences(lessonBody);
const runBlocks = collectRunBlocks(lessonBody);
const hasActiveRunOrPreview = runBlocks.some((b) => b.mode === "run" || (b.mode === "preview" && !b.demo));
const hasNormalCodeFence = fences.some((fence) => {
  const info = (fence.info || "").trim();
  if (/^(?:mermaid|predict|numberline)(?:\s|$)/.test(info)) return false;
  const tokens = info.split(/\s+/);
  if (tokens.includes("run") || tokens.includes("preview")) return false;
  return true;
});
const hasCode = hasActiveRunOrPreview || hasNormalCodeFence;
const hasTable = /^\|.+\|$/m.test(lessonBody);

const allLessons = (await getCollection("lessons")).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allLessons.findIndex((l) => l.data.slug === lesson.data.slug);
const next = currentIndex < allLessons.length - 1 ? allLessons[currentIndex + 1] : null;

import { t } from "../../lib/ui";
import MermaidDiagrams from "../../components/MermaidDiagrams.astro";
---

<Base title={lesson.data.title} description={lesson.data.description}>
  <div class="mb-6">
    <a href="/" class="text-sm text-gray-500 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors">{t("allLessons")}</a>
  </div>

  <header class="island-lesson-header">
    <div class="island-lesson-tags">
      <Tag color="brown" variant="outlined">{t("lessonNumber", { number: lesson.data.order })}</Tag>
      {hasCode && <Tag color="app-blue" variant="soft">含代码</Tag>}
      {hasTable && <Tag color="app-teal" variant="soft">含表格</Tag>}
    </div>
    <h1 class="island-lesson-title"><IslandMark client:load name={lesson.data.title} size="middle" /></h1>
    <IslandTypewriter client:load text={lesson.data.description} />
  </header>

  <div id="lesson-completed-banner" class="island-done-banner hidden" role="status" aria-live="polite">
    <span class="island-done-check" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5 6.2 12 13 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </span>
    <span id="lesson-completed-text">{t("lessonDone")}</span>
  </div>

  <div id="lesson-enroll-nudge" class="hidden mb-8 rounded-lg border border-gray-200 dark:border-stone-700 px-4 py-3 text-sm text-gray-600 dark:text-stone-400">
    <a href="/" class="theme-link font-medium underline underline-offset-2">{t("freeEnroll")}</a>{t("trackProgress")}</div>

  <LessonTabs client:load readLabel="自己阅读" teachLabel="交给教师" />
  <article class="prose dark:prose-invert max-w-none island-lesson-sheet" data-lesson-panel="read" data-lesson-body>
    <Content />
    <MermaidDiagrams />
  </article>
  <SourceCite />
  <div data-lesson-panel="teach" hidden>
    <TeachingMode compact />
    {lesson.data.agentOnly && (
      <div id="lesson-agent-only" class="mt-10 pt-6 border-t border-gray-200 dark:border-stone-800 hidden">
        <p id="lesson-agent-only-text" class="text-center text-sm text-gray-500 dark:text-stone-500">{t("agentContinue")}</p>
      </div>
    )}
  </div>
  <AgentPrompt title={lesson.data.title} />
  {next && (
    <a class="island-next-bar" href={`/lessons/${next.data.slug}`}>{t("nextLesson", { title: next.data.title })}</a>
  )}
  <IslandLessonChrome client:only="react" />

  <script is:inline define:vars={{ lessonSlug: lesson.data.slug, agentOnly: lesson.data.agentOnly }}>
    (function() {
      var banner = document.getElementById("lesson-completed-banner");
      var bannerText = document.getElementById("lesson-completed-text");
      var nudge = document.getElementById("lesson-enroll-nudge");
      var agentOnlyBlock = document.getElementById("lesson-agent-only");
      var agentOnlyText = document.getElementById("lesson-agent-only-text");
      var nextLink = document.querySelector(".island-next-bar");
      if (!window.school) return;

      // Show enroll nudge to unenrolled visitors, hide it once enrolled
      if (!window.school.getStudentId()) {
        if (nudge) nudge.classList.remove("hidden");
        return;
      }
      if (nudge) nudge.classList.add("hidden");

      // Record that this lesson has been visited
      window.school.markLessonVisited(lessonSlug);

      var wasAlreadyComplete = window.school.isLessonComplete(lessonSlug);
      var celebrated = false;

      function noteIslandLessonComplete() {
        window.__islandLessonJustCompleted = true;
        window.dispatchEvent(new CustomEvent("school:island-lesson-complete"));
      }

      function highlightNextAction() {
        if (nextLink) {
          nextLink.classList.add("is-complete");
          nextLink.setAttribute("data-complete", "true");
        }
      }

      function celebrateIfNewlyComplete() {
        var nowComplete = window.school.isLessonComplete(lessonSlug);
        if (celebrated || wasAlreadyComplete || !nowComplete) return false;
        celebrated = true;
        wasAlreadyComplete = true;
        noteIslandLessonComplete();
        highlightNextAction();
        return true;
      }

      function formatBannerText(completion) {
        return window.schoolUI.completion("lesson", completion);
      }

      function showBanner() {
        if (!banner) return;
        var completion = window.school.getLessonCompletion(lessonSlug);
        if (bannerText) bannerText.textContent = formatBannerText(completion);
        banner.classList.remove("hidden");
        highlightNextAction();
      }

      // Agent-only lessons: show the agent-only block instead of the action button
      if (agentOnly && agentOnlyBlock) {
        agentOnlyBlock.classList.remove("hidden");

        if (window.school.isLessonComplete(lessonSlug)) {
          showBanner();
          if (agentOnlyText) agentOnlyText.textContent = window.schoolUI.t("agentDone");
        }

        var origUpdateAgentOnly = window.school.updateAllCheckmarks.bind(window.school);
        window.school.updateAllCheckmarks = function() {
          origUpdateAgentOnly();
          if (nudge && window.school.getStudentId()) nudge.classList.add("hidden");
          if (!window.school.isLessonComplete(lessonSlug)) return;
          showBanner();
          if (agentOnlyText) agentOnlyText.textContent = window.schoolUI.t("agentDone");
          celebrateIfNewlyComplete();
        };
        return;
      }

      if (wasAlreadyComplete) showBanner();

      var origUpdate = window.school.updateAllCheckmarks.bind(window.school);
      window.school.updateAllCheckmarks = function() {
        origUpdate();
        if (nudge && window.school.getStudentId()) nudge.classList.add("hidden");
        if (!window.school.isLessonComplete(lessonSlug)) return;
        showBanner();
        celebrateIfNewlyComplete();
      };
    })();
  </script>
</Base>
